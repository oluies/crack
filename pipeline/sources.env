# Upstream locators. Configuration, not constants — see specs/.../research.md.
#
# Sourced by run.sh. EIA_API_KEY is NOT set here; it comes from the environment
# (or .env, which is gitignored) so a key never lands in the repository.

# --- Window -----------------------------------------------------------------
# First ISO-week Monday published. Everything upstream before this is discarded.
START_WEEK="2022-01-03"

# --- EIA Open Data v2 -------------------------------------------------------
# Two different routes: daily spot lives under pri/spt, weekly retail under
# pri/gnd. A single call cannot serve both.
EIA_SPOT_URL="https://api.eia.gov/v2/petroleum/pri/spt/data/"
EIA_RETAIL_URL="https://api.eia.gov/v2/petroleum/pri/gnd/data/"

EIA_SPOT_SERIES="EER_EPD2DXL0_PF4_Y35NY_DPG RBRTE RWTC"
EIA_RETAIL_SERIES="EMM_EPMR_PTE_NUS_DPG EMD_EPD2D_PTE_NUS_DPG"

# --- EU Weekly Oil Bulletin -------------------------------------------------
# The download path is a UUID the Commission reissues when it republishes; the
# landing page below is the durable locator. If the download 404s, open the page
# and lift the current UUID for "Weekly Oil Bulletin Prices History".
OB_PAGE="https://energy.ec.europa.eu/data-and-analysis/weekly-oil-bulletin_en"
OB_UUID="906e60ca-8b6a-44e7-8589-652854d2fd3f"
OB_FILE="Weekly_Oil_Bulletin_Prices_History_maticni_4web.xlsx"
OB_URL="https://energy.ec.europa.eu/document/download/${OB_UUID}_en?filename=${OB_FILE}"

# --- ECB SDMX ---------------------------------------------------------------
# Daily reference rates, units of the named currency per 1 EUR. Business days
# only — 30_ecb.sql carries the last rate forward over TARGET holidays.
ECB_BASE="https://data-api.ecb.europa.eu/service/data/EXR"
ECB_CURRENCIES="USD SEK"
